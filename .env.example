# AfixTech Business Lead Finder Environment Configuration

# Required: Google Places API Key (Must be real key from Google Cloud Console)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Required: Supabase PostgreSQL Database Connection String
# Example: postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: Flask Secret Key
SECRET_KEY=afixtech_lead_finder_secret_key_change_in_production

# Optional: SMTP Configuration for Email Sending (Dry-run preview if missing)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@afixtech.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=info@afixtech.com
